# Optional. The app reads these from the real environment (PyCharm: Run > Edit Configurations > Environment variables).
CARTIQ_ARTIFACT_DIR=artifacts
CARTIQ_LOG_DIR=logs
CARTIQ_HASH_SALT=change-me-to-a-long-random-string
# If set, POST /admin/reload-models requires header  X-Admin-Key: <value>
CARTIQ_ADMIN_KEY=
